# Gemini API key (required for live ASL interpretation)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alias recognized by this app
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
# If that model is busy, the server tries other Gemini 3 models.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Dedicated 20-class BiLSTM (ONNX on the server). Defaults shown.
# DEDICATED_ASL_ENABLED=true
# DEDICATED_ASL_THRESHOLD=0.45
